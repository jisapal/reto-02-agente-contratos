# Proveedor LLM (solo "anthropic" implementado; ver src/llm/)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Servidor
PORT=3000
# Si se define, la API exige la cabecera x-access-key (el front la pide al abrir)
ACCESS_KEY=

# Topes de costo y robustez
MAX_ITERATIONS=25
MAX_TOKENS_SESSION=200000
LLM_TIMEOUT_MS=60000
RATE_LIMIT_PER_MIN=20
